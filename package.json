{
  "name": "rpgup-pillars-importer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Importador local de Pillars of Eternity para Foundry VTT, sem recursos comerciais incluídos",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test tests/js/*.test.mjs",
